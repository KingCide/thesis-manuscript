<mxfile host="app.diagrams.net" modified="2026-03-25T00:00:00.000Z" agent="Codex" version="24.7.17" compressed="false" type="device">
  <diagram id="fig4_coop_process" name="fig4_coop_process">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CoopSatShield：多星协同工作过程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="20" width="700" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="roi" value="" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=3;dashed=1;dashPattern=8 8;strokeColor=#8E44AD;fillColor=#F8F0FF;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="860" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="roiLabel1" value="ROI（R=4）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#8E44AD;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="150" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="stage1" value="阶段 1：本地证据抽取&#xa;节点 V 观测到受害链路拥塞，满足 c_{v,e*}(τ)=1。&#xa;从本地候选集中提取 top-n 可疑 key，计算本地评分 S_{v,τ}(a)。&#xa;同时统计入端口贡献分布 π_{v,τ}(a,p)，例如 70% / 20% / 10%。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;strokeColor=#F57C00;fillColor=#FFF3E0;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="280" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="stage2" value="阶段 2：EG 证据扩散&#xa;受害节点 V 在 ROI 内逐跳发送 EG。&#xa;蓝色箭头表示 Evidence Gossip，TTL 每跳递减。&#xa;若某节点在发送窗口内已听到 k 条等价证据，则抑制继续转发。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;strokeColor=#1565C0;fillColor=#E3F2FD;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1230" y="110" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="stage3" value="阶段 3：ROI 内协同聚合&#xa;ROI 内多个节点对同一 key 的局部证据被汇总。&#xa;结合拥塞等级与到受害链路的距离，得到网络级评分 S^net(a)。&#xa;当 S^net(a) ≥ Θ_pb 时，触发 pushback。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;strokeColor=#2E7D32;fillColor=#E8F5E9;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1230" y="320" width="300" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="stage4" value="阶段 4：PT 逐跳推回&#xa;橙色箭头表示 PT 沿攻击路径反方向逐跳传播。&#xa;上游节点收到 PT 后安装软状态规则，并继续向更上游传播。&#xa;攻击流在更靠近入口的位置被限速或丢弃，减少无效带宽占用。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeWidth=2;strokeColor=#F57C00;fillColor=#FFF3E0;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1230" y="530" width="300" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="v" value="V" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=3;strokeColor=#D32F2F;fillColor=#FFCDD2;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="380" width="70" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a" value="A" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#2E7D32;fillColor=#F1F8E9;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="290" width="60" height="60" as="geometry"/>

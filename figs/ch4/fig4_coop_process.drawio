        <mxCell id="timeline" value="软状态生命周期 T_life&#xa;epoch τ：PT 安装&#xa;epoch τ+1：规则生效&#xa;epoch τ+10：规则过期清除&#xa;若攻击持续，新 PT 刷新规则" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;strokeColor=#90A4AE;fillColor=#FAFAFA;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
